@startuml

class Report {
  - title_ : std::string
  - lines_ : std::vector<std::string>

  + Report(title : std::string)
  + add_line(line : std::string) : void
  + title() : const std::string&
  + lines() : const std::vector<std::string>&
}

abstract class ReportStrategy {
  + ~ReportStrategy()
  + generate(report : const Report&, filename : const std::string&) : void
}

class CsvReport {
  - {static} escape_csv(value : const std::string&) : std::string

  + generate(report : const Report&, filename : const std::string&) : void
}

class PdfReport {
  + generate(report : const Report&, filename : const std::string&) : void
}

class ReportGenerator {
  - strategy_ : ReportStrategy*

  + ReportGenerator(strategy : ReportStrategy&)
  + set_strategy(strategy : ReportStrategy&) : void
  + generate(report : const Report&, filename : const std::string&) : void
}

ReportStrategy <|-- CsvReport
ReportStrategy <|-- PdfReport

ReportGenerator --> ReportStrategy : uses
CsvReport --> Report : reads
PdfReport --> Report : reads

@enduml